{
  "name": "@art-supabase/hr-module",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Art Supabase Pro 的 HR 人力资源业务模块",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit --pretty false && vite build",
    "preview": "vite preview",
    "boundary:audit": "tsx scripts/audit-module-boundary.ts",
    "lint": "eslint \"src/**/*.{ts,vue}\" \"scripts/**/*.ts\" vite.config.ts",
    "stylelint": "stylelint \"src/**/*.vue\"",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "typecheck": "vue-tsc --noEmit --pretty false",
    "check": "pnpm boundary:audit && pnpm typecheck && pnpm lint && pnpm stylelint && pnpm test:unit"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@file-viewer/preset-all": "2.1.28",
    "@file-viewer/vue3": "2.1.28",
    "@iconify/vue": "^5.0.1",
    "@supabase/supabase-js": "^2.108.2",
    "@vue-flow/background": "1.3.2",
    "@vue-flow/controls": "1.1.3",
    "@vue-flow/core": "1.48.2",
    "@vue-flow/minimap": "1.5.4",
    "@vueuse/core": "^14.3.0",
    "art-supabase-pro": "https://gitee.com/wangyanghub/art-supabase-pro/repository/archive/877b644c9e6fb1b8dc0925b9f5aa64d503a5cbfe.tar.gz",
    "dayjs": "^1.11.21",
    "element-plus": "2.14.3",
    "lodash-es": "^4.18.1",
    "pinia": "^3.0.3",
    "vue": "3.5.40",
    "vue-draggable-plus": "^0.6.0",
    "vue-i18n": "^11.4.6",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.0.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/compiler-sfc": "3.5.40",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.7.0",
    "postcss-html": "^1.8.1",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.8.4",
    "sass": "^1.101.0",
    "stylelint": "^17.13.0",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-recommended-vue": "^1.5.0",
    "stylelint-config-standard": "^40.0.0",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.62.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-element-plus": "^0.11.2",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.1.0",
    "vue-tsc": "~3.3.5"
  },
  "repository": {
    "type": "git",
    "url": "https://gitee.com/wangyanghub/art-supabase-hr.git"
  },
